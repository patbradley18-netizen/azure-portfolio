<!-- Product "keyed": subscription key required; 60 calls a minute and 20,000 a month per key; GET and the refresh POST. -->
<policies>
  <inbound>
    <base />
    <rate-limit calls="60" renewal-period="60" />
    <quota calls="20000" renewal-period="2592000" />
  </inbound>
  <backend><base /></backend>
  <outbound><base /><set-header name="X-Powered-By" exists-action="delete" /></outbound>
  <on-error><base /></on-error>
</policies>
